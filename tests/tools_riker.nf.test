def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            params: [
                input: "${projectDir}/tests/csv/1.0/fastq_single.csv",
                tools: 'riker',
            ],
        ],
    ]

    pipelineTests(delegate, test_scenario)
}
