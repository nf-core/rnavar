nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_rnavar"

    def test_scenario = [
        [
            name: "-profile test",
            params: [],
        ],
        [
            name: "-profile test --dbsnp null --dbsnp_tbi null --known_indels_tbi null",
            params: [
                dbsnp: null,
                dbsnp_tbi: null,
                known_indels_tbi: null,
            ],
        ],
        [
            name: "-profile test --dbsnp_tbi null --known_indels null --known_indels_tbi null",
            params: [
                dbsnp_tbi: null,
                known_indels: null,
                known_indels_tbi: null,
            ],
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
