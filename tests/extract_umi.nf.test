def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            params: [
                extract_umi: true,
                input: "${projectDir}/tests/csv/1.0/fastq_single_end.csv",
                umitools_bc_pattern: "NNNXC",
            ],
            readsStatsPatterns: ['**/*.recal.bam'],
        ],
    ]

    pipelineTests(delegate, test_scenario)
}
