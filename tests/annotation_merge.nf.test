def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            params: [
                input: "${projectDir}/tests/csv/1.0/vcf.csv",
                tools: "merge",
            ],
        ],
            [
            params: [
                input: "${projectDir}/tests/csv/1.0/vcf.csv",
                tools: "merge,snpeff,vep",
            ],
        ],
    ]

    pipelineTests(delegate, test_scenario)
}
