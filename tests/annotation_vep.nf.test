def projectDir = new File('.').absolutePath
def modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            params: [
                input: "${projectDir}/tests/csv/1.0/vcf.csv",
                vep_cache_version: 1,
                tools: 'vep',
            ],
            failure: true,
            snapshotStd: ['stdout'],
            logIgnore: ['Downloading plugin'],
            stdInclude: ['annotation-cache'],
        ],
        [
            params: [
                input: "${projectDir}/tests/csv/1.0/vcf.csv",
                dbnsfp: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/germlineresources/dbsnp_138.hg38.vcf.gz',
                tools: 'vep'
            ],
            failure: true,
            snapshotStd: ['stdout'],
            stdInclude: ['dbnsfp inconsistency'],
        ],
        [
            params: [
                input: "${projectDir}/tests/csv/1.0/vcf.csv",
                tools: 'vep',
                vep_loftee: true,
            ],
            vcfHeaderContains: '|LoF|',
        ],
    ]

    pipelineTests(delegate, test_scenario)
}
